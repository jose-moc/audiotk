DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Evitar listado de directorios
    Options -Indexes

    # No modificar archivos ni directorios existentes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # /controlador/accion/id
    RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([0-9]+)/?$ index.php?c=$1&a=$2&id=$3 [QSA,L]

    # /controlador/accion
    RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ index.php?c=$1&a=$2 [QSA,L]

    # /controlador
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?c=$1 [QSA,L]
</IfModule>
